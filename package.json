{
  "name": "stem-for-impact-countdown",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,blue \"tsx watch server/index.ts --dev\" \"vite\"",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "test:unit": "tsx scripts/unit-test.ts",
    "test:server": "tsx scripts/regression-test.ts",
    "test": "npm run test:unit && npm run test:server",
    "prepare-event": "npm run typecheck && npm test && vite build && tsx scripts/verify-build.ts",
    "start": "node --import tsx server/index.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "test:e2e": "node scripts/e2e-test.cjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/space-grotesk": "^5.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.30.0"
  }
}
