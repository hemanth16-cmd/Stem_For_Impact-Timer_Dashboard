# Environment variables for STEM FOR IMPACT 2026 Countdown Dashboard

# Port to listen on (assigned automatically on Render)
PORT=8080

# Bind host (default: 0.0.0.0)
HOST=0.0.0.0

# Administrator 6-digit PIN (set this in Render Environment Variables for secure admin login)
ADMIN_PIN=

# Persistent data directory
DATA_DIR=./data

# Additional allowed hostnames (comma-separated, optional)
# stem-for-impact-timer-dashboard.onrender.com is allowed by default
ALLOWED_HOSTS=

# Additional allowed origins (comma-separated, optional)
# https://stem-for-impact-timer-dashboard.onrender.com is allowed by default
ALLOWED_ORIGINS=

